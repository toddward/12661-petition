# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
SITE_URL=http://localhost:8787
# Cloudflare's documented always-pass Turnstile test keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Any long random string locally: `openssl rand -base64 32`
FORM_HMAC_KEY=change-me-local-dev-only-0123456789abcdef
# Lets you open /admin on localhost without Cloudflare Access.
# Only honoured when the request host is localhost or 127.0.0.1. Never set in production.
DEV_ADMIN_EMAIL=dev@localhost
EMAIL_ENABLED=false
