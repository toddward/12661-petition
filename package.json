{
  "name": "vll-petition",
  "version": "1.0.0",
  "private": true,
  "description": "Resident-run petition site for speed tables on Victory Lakes Loop (Cloudflare Workers + D1).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply vll-petition-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply vll-petition-db --remote",
    "import-households": "node --experimental-strip-types scripts/import-households.ts"
  },
  "dependencies": {
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261113.1",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
